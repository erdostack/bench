{"event": "start", "id": "25708-1795750811781918697", "target": "scratch", "sql": "SELECT p.status, count(*) FROM nodes p WHERE p.kind='patient' AND NOT EXISTS (SELECT 1 FROM edges a WHERE a.src=p.id AND a.kind='assigned_to') GROUP BY 1; SELECT count(*) FROM (SELECT p.id FROM nodes p JOIN edges r ON r.src=p.id AND r.kind='registered_at' GROUP BY p.id HAVING count(*)>1); SELECT count(*) FROM nodes pr WHERE kind='practice' AND (SELECT count(*) FROM edges WHERE src=pr.id AND kind='lead_dentist')<>1; SELECT p.status,count(*) FROM nodes p WHERE kind='patient' AND (SELECT count(*) FROM edges a WHERE a.src=p.id AND a.kind='assigned_to')>1 GROUP BY 1"}
