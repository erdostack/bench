{"event": "start", "id": "25202-1795750790529593863", "target": "sandbox", "sql": "-- apply /tmp/c3d1-s/mv.py\ndef run(G):\n    moved=[]\n    for h in [u for u,_,d in G.in_edges('CLUB-OTTERS',data=True)] if False else [v for _,v,d in G.out_edges('CLUB-OTTERS',data=True) if d['kind']=='booked']:\n        for _,l,d in list(G.out_edges(h,data=True)):\n            if d['kind']=='on_lane' and l=='POOL-EAST-L3':\n                since=d['since']\n                G.remove_edge(h,l)\n                G.add_edge(h,'POOL-EAST-L5',kind='on_lane',since=since)\n                moved.append(h)\n    return moved\n"}
{"event": "end", "id": "25202-1795750790529593863", "status": "ok"}
