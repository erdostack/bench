{"event": "start", "id": "28052-1795751125041300574", "target": "sandbox", "sql": "-- apply .tj/m.py\nOTTERS_L3 = [\"HIRE-04%02d\" % i for i in range(1, 10)]\ndef run(G):\n    n = 0\n    for h in list(G.nodes):\n        if G.nodes[h][\"kind\"] != \"hire\": continue\n        if not G.has_edge(\"CLUB-OTTERS\", h) or not G.has_edge(h, \"POOL-EAST-L3\"): continue\n        since = G[\"%s\" % h][\"POOL-EAST-L3\"][\"since\"]\n        G.remove_edge(h, \"POOL-EAST-L3\")\n        G.add_edge(h, \"POOL-EAST-L5\", kind=\"on_lane\", since=since)\n        n += 1\n    return n\n"}
{"event": "end", "id": "28052-1795751125041300574", "status": "ok"}
