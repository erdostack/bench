{"event": "start", "id": "23513-1795750375236524964", "target": "sandbox", "sql": "INSERT INTO edges_archive SELECT e.* FROM edges e JOIN nodes d ON d.id = e.dst WHERE e.kind = 'booked_on' AND d.departs_on >= '2024-01-01' AND d.departs_on < '2025-01-01';\nDELETE FROM edges WHERE kind = 'booked_on' AND id IN (SELECT a.id FROM edges_archive a JOIN nodes d ON d.id = a.dst WHERE a.kind = 'booked_on' AND d.departs_on >= '2024-01-01' AND d.departs_on < '2025-01-01');\n"}
{"event": "end", "id": "23513-1795750375236524964", "status": "ok"}
