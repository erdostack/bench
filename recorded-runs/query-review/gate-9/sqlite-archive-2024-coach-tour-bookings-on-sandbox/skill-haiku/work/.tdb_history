{"event": "start", "id": "29409-1795751195109966551", "target": "sandbox", "sql": "INSERT INTO edges_archive (id, kind, src, dst)\nSELECT e.id, e.kind, e.src, e.dst FROM edges e JOIN nodes d ON d.id = e.dst\nWHERE e.kind = 'booked_on' AND d.kind = 'departure' AND d.departs_on >= '2024-01-01' AND d.departs_on < '2025-01-01';\nDELETE FROM edges WHERE kind = 'booked_on' AND dst IN (SELECT id FROM nodes WHERE kind = 'departure' AND departs_on >= '2024-01-01' AND departs_on < '2025-01-01');\n"}
{"event": "end", "id": "29409-1795751195109966551", "status": "ok"}
