{"event": "start", "id": "28401-1795751142308114551", "target": "sandbox", "sql": "INSERT INTO edges_archive (id, kind, src, dst) SELECT id, kind, src, dst FROM edges WHERE kind='booked_on' AND dst IN (SELECT id FROM nodes WHERE kind='departure' AND departs_on >= '2024-01-01' AND departs_on < '2025-01-01'); DELETE FROM edges WHERE kind='booked_on' AND dst IN (SELECT id FROM nodes WHERE kind='departure' AND departs_on >= '2024-01-01' AND departs_on < '2025-01-01')"}
