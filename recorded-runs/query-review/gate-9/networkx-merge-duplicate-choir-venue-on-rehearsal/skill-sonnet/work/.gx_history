{"event": "start", "id": "28411-1795751143357105335", "target": "rehearsal", "sql": "src, dst = \"V-CORNX\", \"V-CORN\"\nfor _, other, d in list(G.edges(src, data=True)):\n    if other == dst:\n        continue\n    m = d[\"minutes\"]\n    if G.has_edge(dst, other):\n        G[dst][other][\"minutes\"] = min(G[dst][other][\"minutes\"], m)\n    else:\n        G.add_edge(dst, other, minutes=m)\nG.remove_node(src)\n"}
{"event": "end", "id": "28411-1795751143357105335", "status": "ok", "saved": true}
