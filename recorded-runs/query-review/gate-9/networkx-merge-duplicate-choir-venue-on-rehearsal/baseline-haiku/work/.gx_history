{"event": "start", "id": "23884-1795750392749889766", "target": "rehearsal", "sql": "\nx, c = 'V-CORNX', 'V-CORN'\nfor nb, d in list(G[x].items()):\n    if nb == c:\n        continue\n    m = d['minutes']\n    if G.has_edge(c, nb):\n        if m < G[c][nb]['minutes']:\n            G[c][nb]['minutes'] = m\n    else:\n        G.add_edge(c, nb, minutes=m)\nG.remove_node(x)\n"}
