{"event": "start", "id": "26129-1795750834438189944", "target": "rehearsal", "sql": "SELECT code,kind,name FROM nodes WHERE code IN ('AP-17','AP-22'); SELECT n.status,count(*) FROM edges e JOIN nodes n ON n.id=e.src WHERE e.kind='kept_at' AND e.dst=(SELECT id FROM nodes WHERE code='AP-17') GROUP BY n.status; SELECT count(*) FROM edges e WHERE e.kind='kept_at' AND e.dst=(SELECT id FROM nodes WHERE code='AP-22'); SELECT n.kind, count(*) FROM edges e JOIN nodes n ON n.id=e.src WHERE e.kind='kept_at' AND e.dst=(SELECT id FROM nodes WHERE code='AP-17') GROUP BY n.kind"}
{"event": "end", "id": "26129-1795750834438189944", "status": "ok"}
{"event": "start", "id": "26204-1795750844178140768", "target": "rehearsal", "sql": "-- apply changes/0032_move_ap17_colonies_to_ap22.py\n\"\"\"0032 (HB-58): Hollin Moor (AP-17) lease ends 1 December; its colonies move to Moor End (AP-22).\nColonies under standstill are NOT moved (docs/movements.md): they keep their kept_at to AP-17 until the\ninspector lifts the standstill and the movements volunteer moves them. Safe to apply again.\"\"\"\nCHUNK = 100\n\n\ndef run(conn):\n    old = conn.execute(\"SELECT id FROM nodes WHERE code = 'AP-17'\").fetchone()[0]\n    new = conn.execute(\"SELECT id FROM nodes WHERE code = 'AP-22'\").fetchone()[0]\n    moved = 0\n    while True:\n        with conn:\n            n = conn.execute(\n                \"UPDATE edges SET dst = ? WHERE id IN (SELECT e.id FROM edges e JOIN nodes c ON c.id = e.src \"\n                \"WHERE e.kind = 'kept_at' AND e.dst = ? AND c.status IS NOT 'standstill' LIMIT ?)\",\n                (new, old, CHUNK)).rowcount\n        if not n:\n            return moved\n        moved += n\n"}
{"event": "end", "id": "26204-1795750844178140768", "status": "ok"}
{"event": "start", "id": "26215-1795750844231944362", "target": "rehearsal", "sql": "-- apply changes/0032_move_ap17_colonies_to_ap22.py\n\"\"\"0032 (HB-58): Hollin Moor (AP-17) lease ends 1 December; its colonies move to Moor End (AP-22).\nColonies under standstill are NOT moved (docs/movements.md): they keep their kept_at to AP-17 until the\ninspector lifts the standstill and the movements volunteer moves them. Safe to apply again.\"\"\"\nCHUNK = 100\n\n\ndef run(conn):\n    old = conn.execute(\"SELECT id FROM nodes WHERE code = 'AP-17'\").fetchone()[0]\n    new = conn.execute(\"SELECT id FROM nodes WHERE code = 'AP-22'\").fetchone()[0]\n    moved = 0\n    while True:\n        with conn:\n            n = conn.execute(\n                \"UPDATE edges SET dst = ? WHERE id IN (SELECT e.id FROM edges e JOIN nodes c ON c.id = e.src \"\n                \"WHERE e.kind = 'kept_at' AND e.dst = ? AND c.status IS NOT 'standstill' LIMIT ?)\",\n                (new, old, CHUNK)).rowcount\n        if not n:\n            return moved\n        moved += n\n"}
{"event": "end", "id": "26215-1795750844231944362", "status": "ok"}
{"event": "start", "id": "26228-1795750844270808282", "target": "rehearsal", "sql": "SELECT n.status,e.dst,count(*) FROM edges e JOIN nodes n ON n.id=e.src WHERE e.kind='kept_at' AND e.dst IN (SELECT id FROM nodes WHERE code IN ('AP-17','AP-22')) GROUP BY 1,2; SELECT count(*) FROM edges WHERE kind='kept_at'"}
{"event": "end", "id": "26228-1795750844270808282", "status": "ok"}
