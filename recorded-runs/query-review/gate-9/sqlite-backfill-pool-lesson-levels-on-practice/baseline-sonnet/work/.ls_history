{"event": "start", "id": "25901-1795750821761859588", "target": "practice", "sql": "SELECT substr(code, length(code)-1), level IS NULL, count(*) FROM nodes WHERE kind='lesson' GROUP BY 1,2"}
{"event": "end", "id": "25901-1795750821761859588", "status": "ok"}
{"event": "start", "id": "25903-1795750821797855369", "target": "practice", "sql": "SELECT code FROM nodes WHERE kind='lesson' AND level IS NULL AND code NOT GLOB 'LS-*-*-*-S[1-7]' LIMIT 20"}
{"event": "end", "id": "25903-1795750821797855369", "status": "ok"}
{"event": "start", "id": "25904-1795750821854388740", "target": "practice", "sql": "SELECT DISTINCT typeof(level), level FROM nodes WHERE kind='lesson'"}
{"event": "end", "id": "25904-1795750821854388740", "status": "ok"}
{"event": "start", "id": "25988-1795750825046758469", "target": "practice", "sql": "UPDATE nodes SET level = CAST(substr(code, -1) AS INTEGER) WHERE kind='lesson' AND level IS NULL AND code GLOB 'LS-*-*-*-S[1-7]'"}
{"event": "end", "id": "25988-1795750825046758469", "status": "ok"}
{"event": "start", "id": "25996-1795750825650326430", "target": "practice", "sql": "SELECT count(*) FROM nodes WHERE kind='lesson' AND level IS NULL"}
{"event": "end", "id": "25996-1795750825650326430", "status": "ok"}
{"event": "start", "id": "25997-1795750825684946382", "target": "practice", "sql": "SELECT count(*) FROM nodes WHERE kind='lesson' AND level IS NOT NULL AND code GLOB 'LS-*-S[1-7]' AND level <> CAST(substr(code,-1) AS INTEGER)"}
{"event": "end", "id": "25997-1795750825684946382", "status": "ok"}
