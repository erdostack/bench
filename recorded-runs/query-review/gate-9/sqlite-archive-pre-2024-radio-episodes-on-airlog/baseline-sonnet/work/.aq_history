{"event": "start", "id": "23154-1795750359659712480", "target": "rehearsal", "sql": "select count(*) from nodes where kind='episode' and aired_on<'2024-01-01'; select count(*) from nodes where kind='episode' and aired_on is null; select count(*) from nodes_archive; select count(*) from edges_archive; select count(*) from edges; select count(*) from nodes; select count(*) from edges e where (src in (select id from nodes_archive) or dst in (select id from nodes_archive)); select count(*) from edges e where kind='repeat_of' and dst in (select id from nodes_archive); select max(c) from (select count(*) c from edges e join nodes n on n.id in (e.src,e.dst) where n.kind='episode' and n.aired_on<'2024-01-01' group by n.id)"}
