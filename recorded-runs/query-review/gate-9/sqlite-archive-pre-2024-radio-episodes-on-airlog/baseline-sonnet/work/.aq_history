{"event": "start", "id": "23339-1795750367349783836", "target": "rehearsal", "sql": "-- apply changes/0008_archive_episodes_before_2024.sql\n-- why: PROG-2026 committee cut-off, episodes aired before 2024-01-01 go to the archive (30 episodes a run; listen-again pages time out on the back catalogue)\nINSERT INTO edges_archive SELECT * FROM edges WHERE src IN (\n    SELECT id FROM nodes WHERE kind = 'episode' AND aired_on < '2024-01-01' ORDER BY id LIMIT 30)\n    OR dst IN (\n    SELECT id FROM nodes WHERE kind = 'episode' AND aired_on < '2024-01-01' ORDER BY id LIMIT 30);\nDELETE FROM edges WHERE src IN (\n    SELECT id FROM nodes WHERE kind = 'episode' AND aired_on < '2024-01-01' ORDER BY id LIMIT 30)\n    OR dst IN (\n    SELECT id FROM nodes WHERE kind = 'episode' AND aired_on < '2024-01-01' ORDER BY id LIMIT 30);\nINSERT INTO nodes_archive SELECT * FROM nodes WHERE id IN (\n    SELECT id FROM nodes WHERE kind = 'episode' AND aired_on < '2024-01-01' ORDER BY id LIMIT 30);\nDELETE FROM nodes WHERE id IN (\n    SELECT id FROM nodes WHERE kind = 'episode' AND aired_on < '2024-01-01' ORDER BY id LIMIT 30);\n"}
{"event": "end", "id": "23339-1795750367349783836", "status": "error"}
{"event": "start", "id": "23341-1795750367391169446", "target": "rehearsal", "sql": "select count(*) from nodes where kind='episode' and aired_on<'2024-01-01'; select count(*) from nodes where kind='episode' and aired_on is null; select count(*) from nodes_archive; select count(*) from edges_archive; select count(*) from edges; select count(*) from nodes; select count(*) from edges where src in (select id from nodes_archive) or dst in (select id from nodes_archive); select count(*) from edges_archive where src not in (select id from nodes_archive union select id from nodes) or dst not in (select id from nodes_archive union select id from nodes); select count(*) from edges_archive a where src not in (select id from nodes_archive) and dst not in (select id from nodes_archive)"}
{"event": "end", "id": "23341-1795750367391169446", "status": "ok"}
