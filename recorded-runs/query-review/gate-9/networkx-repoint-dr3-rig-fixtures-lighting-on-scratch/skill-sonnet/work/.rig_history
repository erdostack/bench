{"event": "start", "id": "27508-1795751096146192073", "target": "scratch", "action": "run", "sql": "-- apply .tmp_job/move.py\ndef run(G):\n    moved = [(u, d[\"circuit\"]) for u, v, d in list(G.in_edges(\"DR-3\", data=True)) if d[\"kind\"] == \"fed_by\"]\n    for u, c in moved:\n        G.remove_edge(u, \"DR-3\")\n        G.add_edge(u, \"DR-5\", kind=\"fed_by\", circuit=c)\n    return f\"moved {len(moved)}\"\n"}
{"event": "end", "id": "27508-1795751096146192073", "status": "ok"}
