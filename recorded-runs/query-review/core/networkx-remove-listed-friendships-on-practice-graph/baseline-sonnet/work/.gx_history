{"event": "start", "id": "1919-1795752345966987435", "target": "practice", "sql": "-- apply /run/scripts_tmp/rm.py\nPAIRS=[(\"P1237\",\"P1223\"),(\"P1330\",\"P1211\"),(\"P1031\",\"P1030\"),(\"P1416\",\"P1431\"),(\"P1229\",\"P1318\"),(\"P1052\",\"P1305\"),(\"P1152\",\"P1066\"),(\"P1107\",\"P1008\")]\ndef run(G):\n    n=0\n    for a,b in PAIRS:\n        assert G.has_edge(a,b) and G.edges[a,b]['kind']=='knows'\n        assert not G.has_edge(b,a)\n        G.remove_edge(a,b); n+=1\n    return n\n"}
{"event": "end", "id": "1919-1795752345966987435", "status": "ok"}
