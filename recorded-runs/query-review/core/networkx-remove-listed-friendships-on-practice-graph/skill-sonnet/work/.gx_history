{"event": "start", "id": "2058-1795752354236667159", "target": "practice", "sql": "-- apply /tmp/rm6065.py\ndef run(G):\n    pairs = [(\"Leopold\",\"Ibbotson\",\"Edda\",\"Eskildsen\"),(\"Dmitri\",\"Dovey\",\"Mira\",\"Eskildsen\"),(\"Jonah\",\"Holloway\",\"Henrik\",\"Midgley\"),(\"Bertil\",\"Ibbotson\",\"Mira\",\"Kavanagh\"),(\"Mira\",\"Bramwell\",\"Edda\",\"Achterberg\"),(\"Saga\",\"Bramwell\",\"Kaia\",\"Ibbotson\"),(\"Iris\",\"Juhl\",\"Otto\",\"Lomax\"),(\"Greta\",\"Midgley\",\"Rasmus\",\"Lomax\")]\n    def find(f,l):\n        return [n for n,d in G.nodes(data=True) if d.get(\"kind\")==\"person\" and d[\"firstName\"]==f and d[\"lastName\"]==l]\n    out=[]\n    for a1,a2,b1,b2 in pairs:\n        A,B=find(a1,a2),find(b1,b2)\n        for a in A:\n            for b in B:\n                for u,v in ((a,b),(b,a)):\n                    if G.has_edge(u,v) and G[u][v].get(\"kind\")==\"knows\":\n                        out.append((a1,a2,b1,b2,u,v)); G.remove_edge(u,v)\n        print(a1,a2,b1,b2,A,B)\n    print(len(out)); \n    return len(out)\n"}
{"event": "end", "id": "2058-1795752354236667159", "status": "ok"}
