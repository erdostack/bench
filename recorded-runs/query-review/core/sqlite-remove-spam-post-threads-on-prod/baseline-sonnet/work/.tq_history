{"event": "start", "id": "2334-1795752374749097689", "target": "scratch", "sql": "-- apply changes/022-remove-mod-5521-spam-threads.sql\n-- 022 (MOD-5521): remove nine spam posts in Cobblewick Market (forum 500) by accounts 1779 and 1780, with their\n-- whole threads (rule M3): the posts 710889, 710994, 711066, 711120, 711253, 711385, 711443, 711507, 711647,\n-- every comment below them at any depth, and the likes and message_tag rows of all those messages.\n-- Nothing else is touched (other posts and comments by these accounts stay, rule M5).\n-- Expected on prod (checked read-only): 9 posts, 401 comments (43 of them direct replies), 1,838 likes,\n-- 423 message_tag rows: 2,671 rows. Count before and after (after must be 0 for all four):\n--   WITH RECURSIVE t(id) AS (SELECT id FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n--     UNION SELECT c.id FROM comment c JOIN t ON c.reply_of_post = t.id OR c.reply_of_comment = t.id)\n--   SELECT (SELECT count(*) FROM t) AS messages, (SELECT count(*) FROM likes WHERE message_id IN t) AS likes,\n--     (SELECT count(*) FROM message_tag WHERE message_id IN t) AS tags;\n-- Bounded for bin/apply (one run changes at most 800 rows; the file is re-run until nothing changes). Order\n-- matters: likes and tags go first, a comment goes only when nothing replies to it and it has no likes or\n-- tags left, and a post goes only when nothing is left under it, so the thread is never cut in the middle\n-- and nothing is left pointing at a removed message.\nDELETE FROM likes WHERE rowid IN (\n  WITH RECURSIVE t(id) AS (\n    SELECT id FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n    UNION SELECT c.id FROM comment c JOIN t ON c.reply_of_post = t.id OR c.reply_of_comment = t.id)\n  SELECT l.rowid FROM likes l WHERE l.message_id IN (SELECT id FROM t) LIMIT 200);\nDELETE FROM message_tag WHERE rowid IN (\n  WITH RECURSIVE t(id) AS (\n    SELECT id FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n    UNION SELECT c.id FROM comment c JOIN t ON c.reply_of_post = t.id OR c.reply_of_comment = t.id)\n  SELECT g.rowid FROM message_tag g WHERE g.message_id IN (SELECT id FROM t) LIMIT 200);\nDELETE FROM comment WHERE id IN (\n  WITH RECURSIVE t(id) AS (\n    SELECT id FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n    UNION SELECT c.id FROM comment c JOIN t ON c.reply_of_post = t.id OR c.reply_of_comment = t.id)\n  SELECT c.id FROM comment c\n  WHERE c.id IN (SELECT id FROM t)\n    AND NOT EXISTS (SELECT 1 FROM comment k WHERE k.reply_of_comment = c.id)\n    AND NOT EXISTS (SELECT 1 FROM likes l WHERE l.message_id = c.id)\n    AND NOT EXISTS (SELECT 1 FROM message_tag g WHERE g.message_id = c.id)\n  LIMIT 200);\nDELETE FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n  AND NOT EXISTS (SELECT 1 FROM comment k WHERE k.reply_of_post = post.id)\n  AND NOT EXISTS (SELECT 1 FROM likes l WHERE l.message_id = post.id)\n  AND NOT EXISTS (SELECT 1 FROM message_tag g WHERE g.message_id = post.id);\n"}
{"event": "end", "id": "2334-1795752374749097689", "status": "error"}
{"event": "start", "id": "2409-1795752380055015932", "target": "scratch", "sql": "-- apply changes/022-remove-mod-5521-spam-threads.sql\n-- 022 (MOD-5521): remove nine spam posts in Cobblewick Market (forum 500) by accounts 1779 and 1780, with their\n-- whole threads (rule M3): the posts 710889, 710994, 711066, 711120, 711253, 711385, 711443, 711507, 711647,\n-- every comment below them at any depth, and the likes and message_tag rows of all those messages.\n-- Nothing else is touched (other posts and comments by these accounts stay, rule M5).\n-- Expected on prod (checked read-only): 9 posts, 401 comments (43 of them direct replies), 1,838 likes,\n-- 423 message_tag rows: 2,671 rows. Count before and after (after must be 0 for all four):\n--   WITH RECURSIVE t(id) AS (SELECT id FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n--     UNION SELECT c.id FROM comment c JOIN t ON c.reply_of_post = t.id OR c.reply_of_comment = t.id)\n--   SELECT (SELECT count(*) FROM t) AS messages, (SELECT count(*) FROM likes WHERE message_id IN t) AS likes,\n--     (SELECT count(*) FROM message_tag WHERE message_id IN t) AS tags,\n-- Bounded for bin/apply (one run changes at most 800 rows, the file is re-run until nothing changes). Order\n-- matters: likes and tags go first, a comment goes only when nothing replies to it and it has no likes or\n-- tags left, and a post goes only when nothing is left under it, so the thread is never cut in the middle\n-- and nothing is left pointing at a removed message.\nDELETE FROM likes WHERE rowid IN (\n  WITH RECURSIVE t(id) AS (\n    SELECT id FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n    UNION SELECT c.id FROM comment c JOIN t ON c.reply_of_post = t.id OR c.reply_of_comment = t.id)\n  SELECT l.rowid FROM likes l WHERE l.message_id IN (SELECT id FROM t) LIMIT 200);\nDELETE FROM message_tag WHERE rowid IN (\n  WITH RECURSIVE t(id) AS (\n    SELECT id FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n    UNION SELECT c.id FROM comment c JOIN t ON c.reply_of_post = t.id OR c.reply_of_comment = t.id)\n  SELECT g.rowid FROM message_tag g WHERE g.message_id IN (SELECT id FROM t) LIMIT 200);\nDELETE FROM comment WHERE id IN (\n  WITH RECURSIVE t(id) AS (\n    SELECT id FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n    UNION SELECT c.id FROM comment c JOIN t ON c.reply_of_post = t.id OR c.reply_of_comment = t.id)\n  SELECT c.id FROM comment c\n  WHERE c.id IN (SELECT id FROM t)\n    AND NOT EXISTS (SELECT 1 FROM comment k WHERE k.reply_of_comment = c.id)\n    AND NOT EXISTS (SELECT 1 FROM likes l WHERE l.message_id = c.id)\n    AND NOT EXISTS (SELECT 1 FROM message_tag g WHERE g.message_id = c.id)\n  LIMIT 200);\nDELETE FROM post WHERE id IN (710889,710994,711066,711120,711253,711385,711443,711507,711647)\n  AND NOT EXISTS (SELECT 1 FROM comment k WHERE k.reply_of_post = post.id)\n  AND NOT EXISTS (SELECT 1 FROM likes l WHERE l.message_id = post.id)\n  AND NOT EXISTS (SELECT 1 FROM message_tag g WHERE g.message_id = post.id);\n"}
{"event": "end", "id": "2409-1795752380055015932", "status": "ok"}
