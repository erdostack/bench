{
  "graph_present": true,
  "profiles": [
    {
      "engine": [
        "neo4j"
      ],
      "engine_version": "5.26.24",
      "query_language": {
        "any_of": [
          "cypher"
        ],
        "cypher_version": "5",
        "cypher_version_required": false
      },
      "driver": {
        "package": [
          "neo4j-java-driver"
        ],
        "version": "5.28.1"
      },
      "run_queries": {
        "accept": [
          "gradlew.*cypher",
          "org\\.talkgraph\\.Cypher"
        ]
      }
    }
  ],
  "access": "read-only",
  "schema_snapshot": {
    "accept": [
      "schema/constraints.cypher",
      "none"
    ]
  }
}
