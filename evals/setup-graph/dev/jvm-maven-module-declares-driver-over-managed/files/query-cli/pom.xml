<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.tramline</groupId>
    <artifactId>tramline-parent</artifactId>
    <version>0.7.0</version>
  </parent>
  <artifactId>tramline-query-cli</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.tramline</groupId>
      <artifactId>tramline-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.neo4j.driver</groupId>
      <artifactId>neo4j-java-driver</artifactId>
      <version>5.28.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <mainClass>org.tramline.cli.QueryCli</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
