CREATE NODE TABLE Person(id INT64, name STRING, PRIMARY KEY (id));
CREATE NODE TABLE Label(id INT64, name STRING, PRIMARY KEY (id));
CREATE NODE TABLE Release(id INT64, title STRING, year INT64, catalogue_no STRING, liner_notes STRING[], PRIMARY KEY (id));
CREATE NODE TABLE Track(id INT64, title STRING, seconds INT64, PRIMARY KEY (id));

CREATE REL TABLE RELEASED_BY(FROM Release TO Label);
CREATE REL TABLE ON_RELEASE(FROM Track TO Release, side STRING, position INT64);
CREATE REL TABLE CREDITED_ON(FROM Person TO Release, role STRING);
CREATE REL TABLE PERFORMS_ON(FROM Person TO Track, instrument STRING);
