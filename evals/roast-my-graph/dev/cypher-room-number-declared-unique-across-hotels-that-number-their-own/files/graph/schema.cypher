CREATE CONSTRAINT hotel_code IF NOT EXISTS FOR (h:Hotel) REQUIRE h.code IS UNIQUE;
CREATE CONSTRAINT room_number IF NOT EXISTS FOR (r:Room) REQUIRE r.number IS UNIQUE;
CREATE CONSTRAINT guest_id IF NOT EXISTS FOR (g:Guest) REQUIRE g.id IS UNIQUE;
CREATE CONSTRAINT booking_ref IF NOT EXISTS FOR (b:Booking) REQUIRE b.ref IS UNIQUE;
