CREATE CONSTRAINT listener_id IF NOT EXISTS FOR (l:Listener) REQUIRE l.id IS UNIQUE;
CREATE CONSTRAINT track_id IF NOT EXISTS FOR (t:Track) REQUIRE t.id IS UNIQUE;
CREATE CONSTRAINT artist_id IF NOT EXISTS FOR (a:Artist) REQUIRE a.id IS UNIQUE;
CREATE CONSTRAINT genre_slug IF NOT EXISTS FOR (g:Genre) REQUIRE g.slug IS UNIQUE;
