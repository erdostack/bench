CREATE CONSTRAINT host_name IF NOT EXISTS FOR (h:Host) REQUIRE h.name IS UNIQUE;
CREATE CONSTRAINT service_name IF NOT EXISTS FOR (s:Service) REQUIRE s.name IS UNIQUE;
CREATE CONSTRAINT team_slug IF NOT EXISTS FOR (t:Team) REQUIRE t.slug IS UNIQUE;
CREATE CONSTRAINT rack_code IF NOT EXISTS FOR (r:Rack) REQUIRE r.code IS UNIQUE;

CREATE INDEX service_tier IF NOT EXISTS FOR (s:Service) ON (s.tier);
