CREATE CONSTRAINT client_id IF NOT EXISTS FOR (c:Client) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT animal_id IF NOT EXISTS FOR (a:Animal) REQUIRE a.id IS UNIQUE;
CREATE CONSTRAINT vet_id IF NOT EXISTS FOR (v:Vet) REQUIRE v.id IS UNIQUE;
CREATE CONSTRAINT visit_id IF NOT EXISTS FOR (v:Visit) REQUIRE v.id IS UNIQUE;
CREATE CONSTRAINT drug_code IF NOT EXISTS FOR (d:Drug) REQUIRE d.code IS UNIQUE;

CREATE INDEX visit_day IF NOT EXISTS FOR (v:Visit) ON (v.day);
