CREATE NODE TABLE Carrier(code STRING, name STRING, PRIMARY KEY(code));
CREATE NODE TABLE Depot(code STRING, city STRING, PRIMARY KEY(code));
CREATE NODE TABLE Customer(id STRING, name STRING, PRIMARY KEY(id));
CREATE NODE TABLE Shipment(id STRING, created DATE, status STRING, weight_kg DOUBLE, charged_eur DOUBLE, PRIMARY KEY(id));
CREATE REL TABLE SHIPPED_BY(FROM Shipment TO Carrier, service STRING, tracking_no STRING);
CREATE REL TABLE ORIGIN(FROM Shipment TO Depot);
CREATE REL TABLE DESTINATION(FROM Shipment TO Depot);
CREATE REL TABLE FOR_CUSTOMER(FROM Shipment TO Customer);
CREATE REL TABLE SCANNED_AT(FROM Shipment TO Depot, at TIMESTAMP, event STRING);
