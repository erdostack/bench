CREATE CONSTRAINT building_code IF NOT EXISTS FOR (b:Building) REQUIRE b.code IS UNIQUE;
CREATE CONSTRAINT room_id IF NOT EXISTS FOR (r:Room) REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT slot_start IF NOT EXISTS FOR (s:Slot) REQUIRE s.start IS UNIQUE;
CREATE CONSTRAINT person_id IF NOT EXISTS FOR (p:Person) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT booking_cell IF NOT EXISTS FOR (b:Booking) REQUIRE b.cell IS UNIQUE;
CREATE INDEX booking_day IF NOT EXISTS FOR (b:Booking) ON (b.day);
