CREATE CONSTRAINT learner_id IF NOT EXISTS FOR (l:Learner) REQUIRE l.id IS UNIQUE;
CREATE CONSTRAINT language_code IF NOT EXISTS FOR (g:Language) REQUIRE g.code IS UNIQUE;
CREATE CONSTRAINT course_id IF NOT EXISTS FOR (c:Course) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT lesson_id IF NOT EXISTS FOR (s:Lesson) REQUIRE s.id IS UNIQUE;
