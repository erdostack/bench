CREATE NODE TABLE Guide(id STRING, title STRING, difficulty INT8, published DATE, PRIMARY KEY (id));
CREATE NODE TABLE Topic(slug STRING, label STRING, PRIMARY KEY (slug));
CREATE NODE TABLE Country(iso STRING, name STRING, PRIMARY KEY (iso));
CREATE NODE TABLE Author(handle STRING, joined DATE, PRIMARY KEY (handle));
CREATE REL TABLE ABOUT(FROM Guide TO Topic);
CREATE REL TABLE AVAILABLE_IN(FROM Guide TO Country);
CREATE REL TABLE WROTE(FROM Author TO Guide, at TIMESTAMP);
