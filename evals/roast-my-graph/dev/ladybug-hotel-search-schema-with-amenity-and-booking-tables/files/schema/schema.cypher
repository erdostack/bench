CREATE NODE TABLE Guest(id STRING, name STRING, PRIMARY KEY(id));
CREATE NODE TABLE Hotel(code STRING, name STRING, city STRING, PRIMARY KEY(code));
CREATE NODE TABLE Booking(id STRING, check_in DATE, nights INT64, status STRING, PRIMARY KEY(id));
CREATE NODE TABLE Review(id STRING, stars INT64, body STRING, PRIMARY KEY(id));
CREATE NODE TABLE Amenity(code STRING, label STRING, PRIMARY KEY(code));
CREATE NODE TABLE HotelAmenity(id STRING, since DATE, fee_eur DOUBLE, PRIMARY KEY(id));
CREATE REL TABLE MADE(FROM Guest TO Booking);
CREATE REL TABLE AT_HOTEL(FROM Booking TO Hotel);
CREATE REL TABLE ABOUT_STAY(FROM Review TO Booking);
CREATE REL TABLE OFFERS(FROM Hotel TO HotelAmenity);
CREATE REL TABLE OF_AMENITY(FROM HotelAmenity TO Amenity);
