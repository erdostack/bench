CREATE CONSTRAINT member_card IF NOT EXISTS FOR (m:Member) REQUIRE m.card_no IS UNIQUE;
CREATE CONSTRAINT copy_barcode IF NOT EXISTS FOR (c:Copy) REQUIRE c.barcode IS UNIQUE;
CREATE CONSTRAINT loan_id IF NOT EXISTS FOR (l:Loan) REQUIRE l.id IS UNIQUE;
CREATE INDEX loan_due IF NOT EXISTS FOR (l:Loan) ON (l.due);
