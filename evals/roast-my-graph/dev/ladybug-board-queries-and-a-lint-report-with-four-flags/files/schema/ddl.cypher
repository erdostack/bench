CREATE NODE TABLE Tenant(id STRING, name STRING, PRIMARY KEY (id));
CREATE NODE TABLE Board(id STRING, title STRING, PRIMARY KEY (id));
CREATE NODE TABLE Card(id STRING, title STRING, status STRING, position INT64, PRIMARY KEY (id));
CREATE NODE TABLE Label(id STRING, name STRING, colour STRING, PRIMARY KEY (id));
CREATE REL TABLE HAS_BOARD(FROM Tenant TO Board);
CREATE REL TABLE ON_BOARD(FROM Card TO Board);
CREATE REL TABLE TAGGED(FROM Card TO Label);
CREATE REL TABLE LABEL_FOR(FROM Label TO Board);
