CREATE NODE TABLE Store(id STRING, name STRING, region STRING, PRIMARY KEY(id));
CREATE NODE TABLE Product(sku STRING, name STRING, PRIMARY KEY(sku));
CREATE NODE TABLE Promo(code STRING, title STRING, active BOOLEAN, starts DATE, ends DATE, PRIMARY KEY(code));
CREATE REL TABLE RUNS_AT(FROM Promo TO Store);
CREATE REL TABLE COVERS(FROM Promo TO Product);
CREATE REL TABLE STOCKS(FROM Store TO Product, qty INT64);
CREATE REL TABLE NEAR(FROM Store TO Store, km DOUBLE);
