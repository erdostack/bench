CREATE NODE TABLE IF NOT EXISTS Paper(
    doi STRING PRIMARY KEY,
    title STRING,
    year INT64,
    venue STRING
);

CREATE NODE TABLE IF NOT EXISTS Author(
    orcid STRING PRIMARY KEY,
    name STRING
);

CREATE NODE TABLE IF NOT EXISTS Topic(
    slug STRING PRIMARY KEY,
    label STRING
);

CREATE REL TABLE IF NOT EXISTS Wrote(FROM Author TO Paper, position INT64);
CREATE REL TABLE IF NOT EXISTS Cites(FROM Paper TO Paper);
CREATE REL TABLE IF NOT EXISTS About(FROM Paper TO Topic);
