CREATE NODE TABLE Cultivar(code STRING PRIMARY KEY, name STRING, species STRING, released INT64);
CREATE NODE TABLE Trial(id STRING PRIMARY KEY, season INT64, design STRING);
CREATE NODE TABLE Site(code STRING PRIMARY KEY, name STRING, soil STRING);
CREATE NODE TABLE Person(id STRING PRIMARY KEY, name STRING, team STRING);

CREATE REL TABLE GrownIn(FROM Cultivar TO Trial, plot STRING, yield_kg_ha DOUBLE);
CREATE REL TABLE HeldAt(FROM Trial TO Site);
CREATE REL TABLE RunBy(FROM Trial TO Person);
CREATE REL TABLE BredFrom(FROM Cultivar TO Cultivar, role STRING);
