CREATE CONSTRAINT building_code IF NOT EXISTS FOR (b:Building) REQUIRE b.code IS UNIQUE;
CREATE CONSTRAINT unit_code IF NOT EXISTS FOR (u:Unit) REQUIRE u.code IS UNIQUE;
CREATE CONSTRAINT lease_id IF NOT EXISTS FOR (l:Lease) REQUIRE l.id IS UNIQUE;
CREATE CONSTRAINT tenant_ref IF NOT EXISTS FOR (t:Tenant) REQUIRE t.ref IS UNIQUE;
