CREATE CONSTRAINT depot_code IF NOT EXISTS FOR (d:Depot) REQUIRE d.code IS UNIQUE;
CREATE CONSTRAINT sku_id IF NOT EXISTS FOR (s:Sku) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT staff_no IF NOT EXISTS FOR (p:Staff) REQUIRE p.staff_no IS UNIQUE;
CREATE CONSTRAINT region_name IF NOT EXISTS FOR (r:Region) REQUIRE r.name IS UNIQUE;
