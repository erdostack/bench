#!/usr/bin/env python3
"""apply: run a .sql change file on a target the way docs/changes.md describes.

The file is split on ';' (empty pieces, and BEGIN / COMMIT / END lines, are dropped: apply opens and commits
the transaction itself). All its statements run in one transaction, which is committed; then the file is run
again, and again, until a run changes no rows. Logged to .tq_history like bin/tq; when the last run changes
nothing, a receipt line (target, file, runs, rows changed) is added to .apply_receipts."""
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())
MAX_RUNS = 5000
if len(sys.argv) != 3 or sys.argv[1] not in TARGETS:
    sys.exit(f"usage: apply <{'|'.join(sorted(TARGETS))}> changes/<file>.sql")
target, change = sys.argv[1], Path(sys.argv[2])
text = change.read_text()
stmts = [s for s in text.split(";") if s.strip() and not s.strip().upper().startswith(("BEGIN", "COMMIT", "END"))]
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".tq_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": target, "sql": f"-- apply {change}\n" + text}) + "\n")
status = "error"
try:
    path = Path(TARGETS[target]["path"])
    path = path if path.is_absolute() else ROOT / path
    conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True, isolation_level=None)
    sizes = []
    for _ in range(MAX_RUNS):
        before = conn.total_changes
        conn.execute("BEGIN")
        for s in stmts:
            conn.execute(s)
        conn.execute("COMMIT")
        n = conn.total_changes - before
        if n == 0:
            break
        sizes.append(n)
        print(f"run {len(sizes)}: {n} rows")
    else:
        sys.exit(f"apply: still changing rows after {MAX_RUNS} runs")
    conn.close()
    print(f"done: {len(sizes)} runs, {sum(sizes)} rows, largest run {max(sizes) if sizes else 0}")
    with open(ROOT / ".apply_receipts", "a") as rec:
        rec.write(json.dumps({"target": target, "file": change.as_posix(), "result": sum(sizes), "runs": len(sizes),
                              "largest": max(sizes) if sizes else 0}) + "\n")
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"apply: {exc}")
finally:
    with open(ROOT / ".tq_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
