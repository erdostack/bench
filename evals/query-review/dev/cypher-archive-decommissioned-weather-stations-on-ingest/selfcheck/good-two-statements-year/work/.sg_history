{"event": "start", "id": "90-1", "target": "ingest", "file": null, "statement": "EXPLAIN MATCH (s:Station) WHERE s.status = 'decommissioned' AND s.decommissionedOn < date('2025-01-01') SET s:ArchivedStation REMOVE s:Station"}
{"event": "end", "id": "90-1", "status": "ok"}
{"event": "start", "id": "91-1", "target": "ingest", "file": null, "statement": "MATCH (s:Station {status: 'decommissioned'}) WHERE s.decommissionedOn.year < 2025 RETURN count(*)"}
