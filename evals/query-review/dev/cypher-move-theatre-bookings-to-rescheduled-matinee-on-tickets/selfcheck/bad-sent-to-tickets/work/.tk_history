{"event": "start", "id": "9000-1000", "target": "tickets", "statement": "MATCH (p:Patron)-[b:BOOKED {status: 'confirmed'}]->(:Performance {code: 'HAM-1128-E'})\nMATCH (n:Performance {code: 'HAM-1214-M'})\nCALL (p, b, n) {\n  CREATE (p)-[:BOOKED {seat: b.seat, status: b.status, price: b.price, bookedAt: b.bookedAt}]->(n)\n  DELETE b\n} IN TRANSACTIONS OF 500 ROWS;\n"}
{"event": "end", "id": "9000-1000", "status": "ok"}
