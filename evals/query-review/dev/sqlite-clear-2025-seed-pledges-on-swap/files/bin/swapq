#!/usr/bin/env python3
"""swapq: run SQL on the swap database (data/swap.db unless --db is given). Every call is logged to .swap_history first."""
import argparse
import json
import os
import sqlite3
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ap = argparse.ArgumentParser(prog="swapq")
ap.add_argument("--db", default=str(ROOT / "data" / "swap.db"))
ap.add_argument("sql")
a = ap.parse_args()
db = Path(a.db).resolve()
where = str(db.relative_to(ROOT)) if db.is_relative_to(ROOT) else str(db)
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".swap_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": where, "sql": a.sql}) + "\n")
status = "error"
try:
    conn = sqlite3.connect(f"file:{db}?mode=rw", uri=True)
    cur = conn.cursor()
    for stmt in [s for s in a.sql.split(";") if s.strip()]:
        cur.execute(stmt)
        if cur.description:
            for row in cur.fetchall():
                print("|".join("" if v is None else str(v) for v in row))
        elif cur.rowcount >= 0:
            print(f"{cur.rowcount} rows")
    conn.commit()
    conn.close()
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"swapq: {exc}")
finally:
    with open(ROOT / ".swap_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
