{"event": "start", "id": "7-0", "target": "sandpit", "file": null, "statement": "// 023: phase 3 passed premises surveyed before 2026-10-01 -> rfs. About 9,400 nodes.\n// Count before/after: MATCH (p:Premises {phase: 3, status: 'passed'}) WHERE p.surveyedOn < '2026-10-01' RETURN count(p);\nMATCH (c:Cabinet)\nCALL (c) {\n  MATCH (p:Premises {phase: 3, status: 'passed'})-[:BEHIND]->(c) WHERE p.surveyedOn < '2026-10-01'\n  SET p.status = 'rfs'\n} IN TRANSACTIONS OF 16 ROWS;\n", "sql": "// 023: phase 3 passed premises surveyed before 2026-10-01 -> rfs. About 9,400 nodes.\n// Count before/after: MATCH (p:Premises {phase: 3, status: 'passed'}) WHERE p.surveyedOn < '2026-10-01' RETURN count(p);\nMATCH (c:Cabinet)\nCALL (c) {\n  MATCH (p:Premises {phase: 3, status: 'passed'})-[:BEHIND]->(c) WHERE p.surveyedOn < '2026-10-01'\n  SET p.status = 'rfs'\n} IN TRANSACTIONS OF 16 ROWS;\n"}
{"event": "end", "id": "7-0", "status": "ok"}
