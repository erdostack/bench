#!/usr/bin/env python3
"""apply: run a data migration's run(conn) on the ladder database. Logged to .lad_history like bin/lad."""
import importlib.util
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGET = tomllib.loads((ROOT / "ladder.toml").read_text())["ladder"]
if len(sys.argv) != 2:
    sys.exit("usage: apply migrations/data/<file>.py")
change = Path(sys.argv[1])
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".lad_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": "ladder",
                          "sql": f"-- apply {change}\n" + change.read_text()}) + "\n")
status = "error"
try:
    path = Path(TARGET["path"])
    path = path if path.is_absolute() else ROOT / path
    conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True)
    spec = importlib.util.spec_from_file_location("change", change)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    print(mod.run(conn))
    conn.close()
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"apply: {exc}")
finally:
    with open(ROOT / ".lad_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
