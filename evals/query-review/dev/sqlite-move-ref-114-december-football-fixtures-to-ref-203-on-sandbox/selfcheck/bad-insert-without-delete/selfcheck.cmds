[["python3", "bin/wm", "sandbox", "INSERT INTO edges (kind, src, dst) SELECT 'refereed_by', e.src, (SELECT id FROM nodes WHERE code = 'REF-203') FROM edges e JOIN nodes f ON f.id = e.src WHERE e.kind = 'refereed_by' AND e.dst = (SELECT id FROM nodes WHERE code = 'REF-114') AND f.kickoff LIKE '2026-12-%'"]]