#!/usr/bin/env python3
"""sq: run SQL on a chartgraph target. Every call is logged to .sq_history before it runs."""
import argparse
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())
ap = argparse.ArgumentParser(prog="sq")
ap.add_argument("target", choices=sorted(TARGETS))
ap.add_argument("sql")
a = ap.parse_args()
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".sq_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": a.target, "sql": a.sql}) + "\n")
status = "error"
try:
    path = Path(TARGETS[a.target]["path"])
    path = path if path.is_absolute() else ROOT / path
    conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True)
    cur = conn.cursor()
    for stmt in [s for s in a.sql.split(";") if s.strip()]:
        cur.execute(stmt)
        if cur.description:
            for row in cur.fetchall():
                print("|".join("" if v is None else str(v) for v in row))
        else:
            print(f"{cur.rowcount} rows changed")
    conn.commit()
    conn.close()
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"sq: {exc}")
finally:
    with open(ROOT / ".sq_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
