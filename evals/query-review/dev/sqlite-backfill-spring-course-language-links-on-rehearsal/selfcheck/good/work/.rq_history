{"event": "start", "id": "90-165", "target": "rehearsal", "sql": "SELECT count(*) FROM nodes c WHERE c.term = '2027-spring' AND c.lang IS NOT NULL AND NOT EXISTS (SELECT 1 FROM edges e WHERE e.kind = 'in_language' AND e.src = c.id)"}
{"event": "end", "id": "90-165", "status": "ok"}
{"event": "start", "id": "91-273", "target": "rehearsal", "sql": "INSERT INTO edges (kind, src, dst)\nSELECT 'in_language', c.id, l.id\nFROM nodes c JOIN nodes l ON l.kind = 'language' AND l.ref = c.lang\nWHERE c.kind = 'course' AND c.term = '2027-spring'\n  AND NOT EXISTS (SELECT 1 FROM edges e WHERE e.kind = 'in_language' AND e.src = c.id)"}
{"event": "end", "id": "91-273", "status": "ok"}
