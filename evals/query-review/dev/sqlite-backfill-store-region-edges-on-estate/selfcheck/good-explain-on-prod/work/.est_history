{"event": "start", "id": "0-1", "target": "estate", "sql": "EXPLAIN QUERY PLAN INSERT INTO edges (kind, src, dst, since) SELECT 'in_region', s.id, r.id, s.opened_on FROM nodes s JOIN nodes r ON r.kind = 'region' AND r.code = s.region_code WHERE s.kind = 'store' AND s.status IN ('trading', 'refit') AND NOT EXISTS (SELECT 1 FROM edges e WHERE e.kind = 'in_region' AND e.src = s.id)"}
{"event": "end", "id": "0-1", "status": "ok"}
