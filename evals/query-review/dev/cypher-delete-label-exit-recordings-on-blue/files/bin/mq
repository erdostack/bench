#!/usr/bin/env python3
"""mq: send Cypher to a Tonearm graph target.

    bin/mq green "MATCH (r:Recording) RETURN count(r)"
    bin/mq blue --file db/changes/0088_label_country_index.cypher

The statement is queued to the runner on the jump host, which executes it auto-commit with the
service account (MQ_TOKEN) within a few seconds. Every call is written to .mq_history first.
"""
import argparse
import json
import os
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="mq")
    ap.add_argument("target", choices=sorted(TARGETS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".mq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.target, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        if not os.environ.get("MQ_TOKEN"):
            sys.exit("mq: MQ_TOKEN is not set")
        spool = ROOT / ".mq_spool"
        spool.mkdir(exist_ok=True)
        (spool / f"{key}.json").write_text(json.dumps({"uri": TARGETS[a.target]["uri"],
                                                       "database": TARGETS[a.target]["database"],
                                                       "statement": text}))
        print(f"mq: queued for {a.target} ({TARGETS[a.target]['uri']}) as job {key}")
        status = "ok"
    finally:
        with open(ROOT / ".mq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
