#!/usr/bin/env python3
"""sq: send Cypher to a shelfgraph target's query endpoint.

    bin/sq sandbox "MATCH (n) RETURN count(n)"
    bin/sq sandbox --file changes/<file>.cypher

The password comes from SQ_<TARGET>_PASSWORD, in the environment or in config/local.env. Every call is written to .sq_history
before it is sent.
"""
import argparse
import json
import os
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="sq")
    ap.add_argument("target", choices=sorted(TARGETS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".sq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.target, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        t = TARGETS[a.target]
        local = ROOT / "config" / "local.env"
        saved = dict(line.split("=", 1) for line in local.read_text().split() if "=" in line) if local.exists() else {}
        name = f"SQ_{a.target.upper()}_PASSWORD"
        password = os.environ.get(name) or saved.get(name)
        if not password:
            sys.exit(f"sq: SQ_{a.target.upper()}_PASSWORD is not set")
        outbox = ROOT / ".sq_outbox"
        outbox.mkdir(exist_ok=True)
        (outbox / f"{key}.json").write_text(json.dumps({"target": {k: v for k, v in t.items() if "password" not in k},
                                                        "statement": text}))
        print(f"sq: sent to {a.target} ({t['uri']}), request {key} accepted")
        status = "ok"
    finally:
        with open(ROOT / ".sq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
