#!/usr/bin/env python3
"""lane: run a script's run(G) on graphs/<graph>.graphml and save the result.

    bin/lane sandbox <script>.py

Read with networkx.read_graphml, written with networkx.write_graphml. Logged to .lane_history first."""
import importlib.util
import json
import os
import sys
import time
from pathlib import Path

import networkx as nx

ROOT = Path(__file__).resolve().parent.parent
GRAPHS = sorted(p.stem for p in (ROOT / "graphs").glob("*.graphml"))
if len(sys.argv) != 3 or sys.argv[1] not in GRAPHS:
    sys.exit(f"usage: lane <{'|'.join(GRAPHS)}> <script.py>")
graph, script = sys.argv[1], Path(sys.argv[2])
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".lane_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": graph, "sql": f"-- apply {script}\n" + script.read_text()}) + "\n")
status = "error"
try:
    path = ROOT / "graphs" / f"{graph}.graphml"
    G = nx.read_graphml(path)
    spec = importlib.util.spec_from_file_location("change", script)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    result = mod.run(G)
    tmp = path.with_suffix(".tmp")
    nx.write_graphml(G, tmp)
    tmp.replace(path)
    print(f"lane: {graph}: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges; run() returned {result!r}")
    status = "ok"
finally:
    with open(ROOT / ".lane_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
