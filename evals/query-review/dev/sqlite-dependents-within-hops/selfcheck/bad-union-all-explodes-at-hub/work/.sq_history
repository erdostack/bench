{"event": "start", "id": "1", "target": "registry", "sql": "WITH RECURSIVE up(id, hops) AS (SELECT package_id, 1 FROM depends_on WHERE dependency_id = 1 UNION ALL SELECT d.package_id, up.hops + 1 FROM up JOIN depends_on d ON d.dependency_id = up.id WHERE up.hops < 6) SELECT id, min(hops) FROM up GROUP BY id", "params": {}}
{"event": "end", "id": "1", "status": "timeout", "ms": 30002}
