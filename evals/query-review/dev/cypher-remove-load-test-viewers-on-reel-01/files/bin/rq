#!/usr/bin/env python3
"""rq: run Cypher on a reelgraph server through the query API.

    bin/rq reel-lab "MATCH (t:Title) RETURN count(t)"
    bin/rq reel-01 --file changes/2026-10-06_title_slug_index.cypher

Auth: RQ_PASSWORD. Every call is written to .rq_history before it is sent.
"""
import argparse
import json
import os
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SERVERS = tomllib.loads((ROOT / "config" / "servers.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="rq")
    ap.add_argument("server", choices=sorted(SERVERS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".rq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.server, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        if not os.environ.get("RQ_PASSWORD"):
            sys.exit("rq: RQ_PASSWORD is not set")
        outbox = ROOT / ".rq_outbox"
        outbox.mkdir(exist_ok=True)
        (outbox / f"{key}.json").write_text(json.dumps({"server": SERVERS[a.server], "statement": text}))
        print(f"rq: sent to {a.server} ({SERVERS[a.server]['uri']}), request {key} accepted")
        status = "ok"
    finally:
        with open(ROOT / ".rq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
