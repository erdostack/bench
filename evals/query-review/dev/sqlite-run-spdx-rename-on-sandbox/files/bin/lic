#!/usr/bin/env python3
"""lic: run SQL on a license-graph target (sandbox unless --target says otherwise). Logs to .lic_history first.

    bin/lic "SELECT license, count(*) FROM version GROUP BY 1"
    bin/lic --file some.sql
    bin/lic --target registry --file changes/NNNN_x.sql      (registry on-call only)
"""
import argparse
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONF = tomllib.loads((ROOT / "config" / "targets.toml").read_text())
ap = argparse.ArgumentParser(prog="lic")
ap.add_argument("sql", nargs="?")
ap.add_argument("--file")
ap.add_argument("--target", default=CONF["default"], choices=[k for k in CONF if k != "default"])
a = ap.parse_args()
text = Path(a.file).read_text() if a.file else (a.sql or "")
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".lic_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": a.target, "sql": text}) + "\n")
status = "error"
try:
    path = Path(CONF[a.target]["path"])
    path = path if path.is_absolute() else ROOT / path
    conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True)
    cur = conn.cursor()
    for stmt in [s for s in text.split(";") if s.strip()]:
        cur.execute(stmt)
        if cur.description:
            for row in cur.fetchall():
                print("|".join("" if v is None else str(v) for v in row))
    conn.commit()
    conn.close()
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"lic: {exc}")
finally:
    with open(ROOT / ".lic_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
