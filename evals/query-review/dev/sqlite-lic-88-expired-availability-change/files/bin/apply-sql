#!/usr/bin/env python3
"""apply-sql <db> <file.sql>: run a change file in one transaction."""
import sqlite3
import sys

if len(sys.argv) != 3:
    sys.exit("usage: apply-sql <db> changes/<file>.sql")
conn = sqlite3.connect(sys.argv[1])
with conn:
    conn.executescript(open(sys.argv[2]).read())
print("applied", sys.argv[2])
