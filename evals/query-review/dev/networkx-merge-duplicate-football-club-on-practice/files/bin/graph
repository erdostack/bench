#!/usr/bin/env python3
"""graph: look at or change a northvale-club-directory graph.

    bin/graph practice stats
    bin/graph practice show CL-0112
    bin/graph practice apply my_change.py      (calls change(G) from the script, then saves the graph)
"""
import importlib.util
import json
import sys
from pathlib import Path

import networkx as nx

ROOT = Path(__file__).resolve().parent.parent
FILES = {"directory": ROOT / "data" / "directory.json", "practice": ROOT / "data" / "practice.json"}


def load(path):
    return nx.node_link_graph(json.loads(path.read_text()))


def save(G, path):
    path.write_text(json.dumps(nx.node_link_data(G), indent=1, sort_keys=True))


def main():
    if len(sys.argv) < 3 or sys.argv[1] not in FILES:
        sys.exit(__doc__)
    path, cmd = FILES[sys.argv[1]], sys.argv[2]
    G = load(path)
    if cmd == "stats":
        kinds = {}
        for _n, d in G.nodes(data=True):
            kinds[d.get("kind")] = kinds.get(d.get("kind"), 0) + 1
        print(f"{G.number_of_nodes()} nodes {kinds}, {G.number_of_edges()} edges")
    elif cmd == "show" and len(sys.argv) == 4:
        n = sys.argv[3]
        print(n, G.nodes[n])
        for u, v, d in list(G.in_edges(n, data=True)) + list(G.out_edges(n, data=True)):
            print(f"  {u} -> {v} {d}")
    elif cmd == "apply" and len(sys.argv) == 4:
        spec = importlib.util.spec_from_file_location("change", sys.argv[3])
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        print(mod.change(G))
        save(G, path)
        print(f"saved {path.name}: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
