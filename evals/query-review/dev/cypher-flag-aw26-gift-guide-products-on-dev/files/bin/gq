#!/usr/bin/env python3
"""gq: run Cypher on a shopgraph server.

    bin/gq dev "MATCH (p:Product) RETURN count(p)"
    bin/gq live --file migrations/031_product_sku_constraint.cypher

dev needs no password; live needs GQ_LIVE_PASSWORD. Every call is written to .gq_history before it is sent.
"""
import argparse
import json
import os
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SERVERS = tomllib.loads((ROOT / "config" / "servers.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="gq")
    ap.add_argument("server", choices=sorted(SERVERS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".gq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.server, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        need = SERVERS[a.server].get("password_env")
        if need and not os.environ.get(need):
            sys.exit(f"gq: {need} is not set")
        outbox = ROOT / ".gq_outbox"
        outbox.mkdir(exist_ok=True)
        (outbox / f"{key}.json").write_text(json.dumps({"server": SERVERS[a.server], "statement": text}))
        print(f"gq: sent to {a.server} ({SERVERS[a.server]['uri']}), request {key} accepted")
        status = "ok"
    finally:
        with open(ROOT / ".gq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
