#!/usr/bin/env python3
"""inv: run SQL on a netinv target. Every call is logged to .inv_history before it runs."""
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())
if len(sys.argv) != 3 or sys.argv[1] not in TARGETS:
    sys.exit(f"usage: inv <{'|'.join(sorted(TARGETS))}> \"<sql>\"")
target, text = sys.argv[1], sys.argv[2]
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".inv_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": target, "sql": text}) + "\n")
status = "error"
try:
    path = Path(TARGETS[target]["path"])
    path = path if path.is_absolute() else ROOT / path
    conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True)
    cur = conn.cursor()
    for stmt in [s for s in text.split(";") if s.strip()]:
        cur.execute(stmt)
        if cur.description:
            for row in cur.fetchall():
                print("|".join("" if v is None else str(v) for v in row))
        elif cur.rowcount >= 0:
            print(f"{cur.rowcount} rows changed")
    conn.commit()
    conn.close()
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"inv: {exc}")
finally:
    with open(ROOT / ".inv_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
