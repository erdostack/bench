python3 -c "import json,networkx as nx; p='var/practice/fleet.json'; G=nx.node_link_graph(json.load(open(p)), edges='links'); [ (G.remove_edge(u,v), G.add_edge(u,'C-22',**d)) for u,v,d in list(G.edges(data=True)) if v=='C-14' and d['kind']=='run_by' and '2026-12-01'<=G.nodes[u]['departs_on']<='2026-12-12']; json.dump(nx.node_link_data(G, edges='links'), open(p,'w'))"
