#!/usr/bin/env python3
"""cq: run Cypher on a clinicgraph target through its HTTP query endpoint.

    bin/cq dev "MATCH (n) RETURN count(n)"
    bin/cq clinicgraph --file changes/<file>.cypher

Credentials come from the machine's service account. Every call is written to .cq_history before it is sent.
"""
import argparse
import json
import os
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config/targets.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="cq")
    ap.add_argument("target", choices=sorted(TARGETS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".cq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.target, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        t = TARGETS[a.target]
        outbox = ROOT / ".cq_outbox"
        outbox.mkdir(exist_ok=True)
        (outbox / f"{key}.json").write_text(json.dumps({"target": t, "statement": text}))
        print(f"cq: sent to {a.target} ({t['uri']}, database {t['database']}), request {key} accepted")
        status = "ok"
    finally:
        with open(ROOT / ".cq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
