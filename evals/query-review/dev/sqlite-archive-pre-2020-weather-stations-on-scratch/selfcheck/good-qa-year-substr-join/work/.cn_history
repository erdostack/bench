{"event": "start", "id": "9-1", "target": "scratch", "sql": "DELETE FROM edges WHERE rowid IN (SELECT e.rowid FROM edges e JOIN nodes n ON n.id = e.src WHERE e.kind = 'reports_to' AND n.status = 'retired' AND substr(n.retired_on, 1, 4) < '2020');\nUPDATE nodes SET status = 'archived' WHERE kind = 'station' AND status = 'retired' AND CAST(substr(retired_on, 1, 4) AS INTEGER) < 2020;\n"}
{"event": "end", "id": "9-1", "status": "ok"}
