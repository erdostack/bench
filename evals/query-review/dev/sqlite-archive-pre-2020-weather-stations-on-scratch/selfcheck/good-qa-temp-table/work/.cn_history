{"event": "start", "id": "9-1", "target": "scratch", "sql": "CREATE TEMP TABLE old_st AS SELECT id FROM nodes WHERE kind = 'station' AND status = 'retired' AND date(retired_on) < date('2020-01-01');\nUPDATE nodes SET status = 'archived' WHERE id IN (SELECT id FROM old_st);\nDELETE FROM edges WHERE kind = 'reports_to' AND src IN (SELECT id FROM old_st);\n"}
{"event": "end", "id": "9-1", "status": "ok"}
