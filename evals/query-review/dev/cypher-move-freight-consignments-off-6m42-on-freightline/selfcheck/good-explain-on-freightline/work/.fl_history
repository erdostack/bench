{"event": "start", "id": "1-1", "target": "freightline", "file": null, "statement": "MATCH (c:Consignment)-[:BOOKED_ON]->(:Train {headcode: '6M42', runDate: date('2026-11-28')}) RETURN c.dgClass IS NULL AS ordinary, count(*)"}
