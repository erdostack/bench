#!/usr/bin/env python3
"""rig: look at or change a hallb-rig target. Every call is logged to .rig_history before it runs.

    bin/rig <target> show [node]
    bin/rig <target> run <script.py>      # the script defines run(G); the graph is saved afterwards
"""
import argparse
import importlib.util
import json
import os
import sys
import time
from pathlib import Path

import networkx as nx

ROOT = Path(__file__).resolve().parent.parent
TARGETS = {"plan": ROOT / "data" / "hallb-rig.json", "scratch": ROOT / "data" / "scratch-rig.json"}
ap = argparse.ArgumentParser(prog="rig")
ap.add_argument("target", choices=sorted(TARGETS))
ap.add_argument("action", choices=["show", "run"])
ap.add_argument("arg", nargs="?")
a = ap.parse_args()
key = f"{os.getpid()}-{time.time_ns()}"
text = Path(a.arg).read_text() if a.action == "run" and a.arg else ""
with open(ROOT / ".rig_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": a.target, "action": a.action,
                          "sql": (f"-- apply {a.arg}\n" + text) if a.action == "run" else f"show {a.arg or ''}"}) + "\n")
status = "error"
try:
    path = TARGETS[a.target]
    G = nx.node_link_graph(json.loads(path.read_text()), edges="links")
    if a.action == "show":
        if a.arg:
            print(a.arg, G.nodes[a.arg])
            for u, v, d in list(G.in_edges(a.arg, data=True)) + list(G.out_edges(a.arg, data=True)):
                print(f"  {u} -> {v} {d}")
        else:
            kinds = {}
            for _n, d in G.nodes(data=True):
                kinds[d.get("kind")] = kinds.get(d.get("kind"), 0) + 1
            print(f"{G.number_of_nodes()} nodes {kinds}, {G.number_of_edges()} edges")
    else:
        spec = importlib.util.spec_from_file_location("change", a.arg)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        print(mod.run(G))
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(nx.node_link_data(G, edges="links"), indent=1))
        tmp.replace(path)
    status = "ok"
finally:
    with open(ROOT / ".rig_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
