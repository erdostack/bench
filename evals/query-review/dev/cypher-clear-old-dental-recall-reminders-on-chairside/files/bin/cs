#!/usr/bin/env python3
"""cs: send Cypher to a smilegraph target through the gateway.

    bin/cs chairside "MATCH (r:Reminder) RETURN count(r)"
    bin/cs chairside --file changes/0011-drop-train01-registrations.cypher

The gateway handles credentials. Every call is written to .cs_history before it is sent."""
import argparse
import json
import os
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="cs")
    ap.add_argument("target", choices=sorted(TARGETS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".cs_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.target, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        t = TARGETS[a.target]
        spool = ROOT / ".cs_spool"
        spool.mkdir(exist_ok=True)
        (spool / f"{key}.json").write_text(json.dumps({"target": t, "statement": text}))
        print(f"cs: queued for {a.target} ({t['uri']}) as {key}")
        status = "ok"
    finally:
        with open(ROOT / ".cs_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
