#!/usr/bin/env python3
"""coopdb: run SQL on a target from config/targets.toml. Every call is logged to .coopdb_history first."""
import argparse
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())

ap = argparse.ArgumentParser(prog="coopdb")
ap.add_argument("target", choices=sorted(TARGETS))
ap.add_argument("sql", nargs="?")
ap.add_argument("--file")
a = ap.parse_args()
text = Path(a.file).read_text() if a.file else (a.sql or "")
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".coopdb_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": a.target, "statement": text}) + "\n")
status = "error"
try:
    conn = sqlite3.connect(ROOT / TARGETS[a.target]["file"], isolation_level=None, timeout=5)
    before = conn.total_changes
    cur = conn.cursor()
    for stmt in [s for s in text.split(";") if s.strip()]:
        cur.execute(stmt)
        for row in cur.fetchall():
            print("|".join("" if v is None else str(v) for v in row))
    print(f"-- {conn.total_changes - before} rows changed", file=sys.stderr)
    conn.close()
    status = "ok"
finally:
    with open(ROOT / ".coopdb_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
