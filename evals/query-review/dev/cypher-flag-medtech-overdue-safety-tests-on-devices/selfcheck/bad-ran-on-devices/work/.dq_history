{"event": "start", "id": "2-1", "target": "devices", "file": "changes/015_flag_est_overdue.cypher", "statement": "MATCH (d:Device) WHERE d.status = 'in_service' AND (d.lastEstOn IS NULL OR d.lastEstOn < date('2025-11-24')) CALL (d) { SET d.estOverdue = true } IN TRANSACTIONS OF 2000 ROWS;"}
{"event": "end", "id": "2-1", "status": "ok"}
