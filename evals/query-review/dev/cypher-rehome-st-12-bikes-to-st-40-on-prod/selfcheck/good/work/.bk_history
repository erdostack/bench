{"event": "start", "id": "7001-1", "target": "prod", "file": null, "statement": "EXPLAIN MATCH (b:Bike)-[h:HOMED_AT]->(:Station {code: 'ST-12'})\nMATCH (n:Station {code: 'ST-40'})\nCREATE (b)-[:HOMED_AT {since: date()}]->(n)\nDELETE h;\n"}
