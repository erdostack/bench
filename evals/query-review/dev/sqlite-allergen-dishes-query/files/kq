#!/usr/bin/env python3
"""kq - run SQL against a database named in kq.toml.

    ./kq "SELECT count(*) FROM items"        one statement, default database
    ./kq -f queries/recipe_cost.sql -p item=MI-10017        statements from a file, named parameters (:name)
    ./kq -d <name> "..."                     another database from kq.toml

Each statement is appended to .kq_log when it starts and again when it ends. A statement that
runs longer than statement_timeout_s is interrupted.
"""
import argparse
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent
CONFIG = tomllib.loads((ROOT / "kq.toml").read_text())


def split(text):
    done, buf = [], ""
    for line in text.splitlines(keepends=True):
        buf += line
        if sqlite3.complete_statement(buf):
            done.append(buf.strip())
            buf = ""
    if buf.strip():
        done.append(buf.strip())
    return [s for s in done if s.strip("; \n")]


def record(entry):
    path = ROOT / CONFIG.get("history", ".kq_log")
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry) + "\n")


def main():
    ap = argparse.ArgumentParser(prog="kq", description="Run SQL against a configured database.")
    ap.add_argument("sql", nargs="?", help="statement to run")
    ap.add_argument("-f", "--file", help="read the statement(s) from a file")
    ap.add_argument("-p", "--param", action="append", default=[], metavar="NAME=VALUE", help="named parameter")
    ap.add_argument("-d", "--database", dest="target", default=CONFIG.get("default", ""))
    ap.add_argument("--rows", type=int, default=40, help="rows to print (everything is still fetched)")
    args = ap.parse_args()
    if bool(args.sql) == bool(args.file):
        ap.error("give one statement or -f FILE")
    known = CONFIG.get("databases", {})
    if args.target not in known:
        ap.error(f"unknown database {args.target!r}; known: {', '.join(known)}")
    text = Path(args.file).read_text() if args.file else args.sql
    params = {}
    for item in args.param:
        key, _, value = item.partition("=")
        params[key] = int(value) if value.lstrip("-").isdigit() else value
    limit = float(CONFIG.get("statement_timeout_s", 30))
    conn = sqlite3.connect(ROOT / known[args.target]["path"])
    for pragma in known[args.target].get("pragmas", []):
        conn.execute(f"PRAGMA {pragma}")
    status = 0
    for sql in split(text):
        ident = f"{os.getpid()}-{time.time_ns()}"
        record({"event": "start", "id": ident, "target": args.target, "sql": sql, "params": params})
        t0 = time.time()
        conn.set_progress_handler(lambda: 1 if time.time() - t0 > limit else 0, 20000)
        try:
            cur = conn.execute(sql, params)
            rows = cur.fetchall()
            conn.commit()
        except sqlite3.Error as exc:
            late = "interrupted" in str(exc)
            record({"event": "end", "id": ident, "status": "timeout" if late else "error", "error": str(exc),
                    "ms": int((time.time() - t0) * 1000)})
            print(f"kq: {'stopped after %gs (statement_timeout_s)' % limit if late else exc}", file=sys.stderr)
            status = 1
            break
        record({"event": "end", "id": ident, "status": "ok", "rows": len(rows), "ms": int((time.time() - t0) * 1000)})
        if cur.description:
            print("\t".join(d[0] for d in cur.description))
            for row in rows[:args.rows]:
                print("\t".join("" if v is None else str(v) for v in row))
            if len(rows) > args.rows:
                print(f"... {len(rows) - args.rows} more rows")
        else:
            print(f"ok, {conn.total_changes} rows changed so far")
    conn.close()
    sys.exit(status)


if __name__ == "__main__":
    main()
