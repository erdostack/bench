#!/usr/bin/env python3
"""wq: send Cypher to a playgraph target over the station VPN.

    bin/wq studio-b "MATCH (t:Track {isrc: 'GBAYE0601498'}) RETURN t.title"
    bin/wq studio-b --file changes/<file>.cypher

Uses the tech rota's service login. Every call is written to .wq_history before it is sent.
"""
import argparse
import json
import os
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config/targets.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="wq")
    ap.add_argument("target", choices=sorted(TARGETS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".wq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.target, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        t = TARGETS[a.target]
        outbox = ROOT / ".wq_outbox"
        outbox.mkdir(exist_ok=True)
        (outbox / f"{key}.json").write_text(json.dumps({"target": t, "statement": text}))
        print(f"wq: sent to {a.target} ({t['uri']}), request {key} queued")
        status = "ok"
    finally:
        with open(ROOT / ".wq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
