#!/usr/bin/env python3
"""kq: run Cypher on a target through cypher-shell.

    bin/kq dev "MATCH (p:Pallet) RETURN count(p)"
    bin/kq dev --file ops/2026-10-08-zone-k-aisles.cypher

Password from KQ_<TARGET>_PASSWORD. Each call is appended to .kq_history before it runs.
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="kq")
    ap.add_argument("target", choices=sorted(TARGETS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = (ROOT / a.file).read_text() if a.file and not Path(a.file).is_absolute() else (Path(a.file).read_text() if a.file else a.cypher)
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".kq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.target, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        pw = os.environ.get(f"KQ_{a.target.upper().replace('-', '_')}_PASSWORD")
        if not pw:
            sys.exit(f"kq: KQ_{a.target.upper().replace('-', '_')}_PASSWORD is not set")
        if not shutil.which("cypher-shell"):
            sys.exit("kq: cypher-shell not found")
        t = TARGETS[a.target]
        p = subprocess.run(["cypher-shell", "-a", t["uri"], "-d", t["database"], "-u", "ops", "-p", pw], input=text, text=True)
        status = "ok" if p.returncode == 0 else "error"
        sys.exit(p.returncode)
    finally:
        with open(ROOT / ".kq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
