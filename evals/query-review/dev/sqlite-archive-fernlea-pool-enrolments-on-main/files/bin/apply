#!/usr/bin/env python3
"""apply: run a change file's run(conn) on a target. Logged to .sg_history like bin/sg; when run() returns,
a receipt line (target, file, what run() returned) is added to .apply_receipts."""
import importlib.util
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())
if len(sys.argv) != 3 or sys.argv[1] not in TARGETS:
    sys.exit(f"usage: apply <{'|'.join(sorted(TARGETS))}> changes/<file>.py")
target, change = sys.argv[1], Path(sys.argv[2])
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".sg_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": target,
                          "sql": f"-- apply {change}\n" + change.read_text()}) + "\n")
status = "error"
try:
    path = Path(TARGETS[target]["path"])
    path = path if path.is_absolute() else ROOT / path
    conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True)
    spec = importlib.util.spec_from_file_location("change", change)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    result = mod.run(conn)
    conn.close()
    print(result)
    with open(ROOT / ".apply_receipts", "a") as rec:
        rec.write(json.dumps({"target": target, "file": change.as_posix(), "result": repr(result)}) + "\n")
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"apply: {exc}")
finally:
    with open(ROOT / ".sg_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
