#!/usr/bin/env python3
"""rq: send Cypher to a routemap target through the query gateway.

    bin/rq dev "MATCH (s:Stop) RETURN s.zone, count(*)"
    bin/rq live --file changes/0042-reopen-st4410.cypher

The gateway handles credentials. Every call is written to .rq_history before it is sent."""
import argparse
import json
import os
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="rq")
    ap.add_argument("target", choices=sorted(TARGETS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".rq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.target, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        outbox = ROOT / ".rq_outbox"
        outbox.mkdir(exist_ok=True)
        (outbox / f"{key}.json").write_text(json.dumps({"target": TARGETS[a.target], "statement": text}))
        print(f"rq: sent to {a.target} ({TARGETS[a.target]['uri']}), request {key} accepted")
        status = "ok"
    finally:
        with open(ROOT / ".rq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
