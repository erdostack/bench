#!/usr/bin/env python3
"""scratch: bin/scratch changes/<file>.py loads data/scratch-graph.json, calls run(G), saves, prints the result."""
import importlib.util
import json
import sys
from pathlib import Path

import networkx as nx

ROOT = Path(__file__).resolve().parent.parent
PATH = ROOT / "data" / "scratch-graph.json"
if len(sys.argv) != 2:
    sys.exit(__doc__)
spec = importlib.util.spec_from_file_location("change", sys.argv[1])
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
G = nx.node_link_graph(json.loads(PATH.read_text()))
result = mod.run(G)
PATH.write_text(json.dumps(nx.node_link_data(G), indent=1))
print(result)
print(f"saved: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges")
