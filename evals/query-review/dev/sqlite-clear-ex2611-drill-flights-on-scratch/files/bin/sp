#!/usr/bin/env python3
"""sp: run SQL on a stand-planner target. Every call is written to .sp_history first.

    bin/sp scratch "SELECT exercise, count(*) FROM node WHERE kind = 'flight' GROUP BY 1"
"""
import json
import os
import sqlite3
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())
args = sys.argv[1:]
if len(args) != 2 or args[0] not in TARGETS:
    sys.exit(__doc__)
target, sql = args
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".sp_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": target, "sql": sql}) + "\n")
status = "error"
try:
    conn = sqlite3.connect(f"file:{ROOT / TARGETS[target]['path']}?mode=rw", uri=True, timeout=5)
    cur = conn.cursor()
    for stmt in [s for s in sql.split(";") if s.strip()]:
        cur.execute(stmt)
        if cur.description:
            for row in cur.fetchall():
                print("|".join("" if v is None else str(v) for v in row))
        elif cur.rowcount >= 0:
            print(f"({cur.rowcount} rows)")
    conn.commit()
    conn.close()
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"sp: {exc}")
finally:
    with open(ROOT / ".sp_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
