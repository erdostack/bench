{"event": "start", "id": "14250-1795746343508994687", "target": "practice", "sql": "-- apply changes/0009_collected_by_before_2024.py\n\"\"\"0009 (SW-19): collected_by from collector_code, reports before 2024.\"\"\"\n\n\ndef run(conn):\n    total = 0\n    while True:\n        cur = conn.execute(\n            \"INSERT INTO edges (kind, src, dst) SELECT 'collected_by', r.id, m.id FROM nodes r, nodes m \"\n            \"WHERE r.kind = 'report' AND r.status = 'collected' AND m.kind = 'member' AND m.code = r.collector_code \"\n            \"AND r.reported_on < '2024-01-01' AND NOT EXISTS (SELECT 1 FROM edges e WHERE e.src = r.id AND e.kind = 'collected_by') LIMIT 400\")\n        conn.commit()\n        if cur.rowcount == 0:\n            return total\n        total += cur.rowcount\n"}
{"event": "end", "id": "14250-1795746343508994687", "status": "ok"}
{"event": "start", "id": "14251-1795746343585727191", "target": "practice", "sql": "-- apply changes/0010_collected_by_2024_on.py\n\"\"\"0010 (SW-19): collected_by from collector_code, reports from 2024.\"\"\"\n\n\ndef run(conn):\n    total = 0\n    while True:\n        cur = conn.execute(\n            \"INSERT INTO edges (kind, src, dst) SELECT 'collected_by', r.id, m.id FROM nodes r, nodes m \"\n            \"WHERE r.kind = 'report' AND r.status = 'collected' AND m.kind = 'member' AND m.code = r.collector_code \"\n            \"AND r.reported_on >= '2024-01-01' AND NOT EXISTS (SELECT 1 FROM edges e WHERE e.src = r.id AND e.kind = 'collected_by') LIMIT 400\")\n        conn.commit()\n        if cur.rowcount == 0:\n            return total\n        total += cur.rowcount\n"}
{"event": "end", "id": "14251-1795746343585727191", "status": "ok"}
