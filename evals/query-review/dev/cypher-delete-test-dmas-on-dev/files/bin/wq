#!/usr/bin/env python3
"""wq: run Cypher on a dmagraph target through its query endpoint.

    bin/wq dev "MATCH (d:DMA) RETURN count(d)"
    bin/wq network --file changes/0031-dma-code-constraint.cypher

The password comes from WQ_<TARGET>_PASSWORD (dev falls back to its default). Every call is written to
.wq_history first.
"""
import argparse
import json
import os
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGETS = tomllib.loads((ROOT / "config" / "targets.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="wq")
    ap.add_argument("target", choices=sorted(TARGETS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".wq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.target, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        t = TARGETS[a.target]
        password = os.environ.get(f"WQ_{a.target.upper()}_PASSWORD") or t.get("default_password")
        if not password:
            sys.exit(f"wq: WQ_{a.target.upper()}_PASSWORD is not set")
        outbox = ROOT / ".wq_outbox"
        outbox.mkdir(exist_ok=True)
        (outbox / f"{key}.json").write_text(json.dumps({"target": {k: v for k, v in t.items() if "password" not in k},
                                                        "statement": text}))
        print(f"wq: sent to {a.target} ({t['uri']}), request {key} accepted")
        status = "ok"
    finally:
        with open(ROOT / ".wq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
