#!/usr/bin/env python3
"""lq: run Cypher on a loyalty graph server through the query API.

    bin/lq orbit-lab "MATCH (o:Offer) RETURN count(o)"
    bin/lq orbit --file changes/0041_offer_expires_index.cypher

Auth: LQ_PASSWORD. Every call is written to .lq_history before it is sent.
"""
import argparse
import json
import os
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SERVERS = tomllib.loads((ROOT / "config" / "servers.toml").read_text())


def main():
    ap = argparse.ArgumentParser(prog="lq")
    ap.add_argument("server", choices=sorted(SERVERS))
    ap.add_argument("cypher", nargs="?")
    ap.add_argument("--file")
    a = ap.parse_args()
    if bool(a.cypher) == bool(a.file):
        ap.error("give a statement or --file")
    text = Path(a.file).read_text() if a.file else a.cypher
    key = f"{os.getpid()}-{time.time_ns()}"
    with open(ROOT / ".lq_history", "a", encoding="utf-8") as log:
        log.write(json.dumps({"event": "start", "id": key, "target": a.server, "file": a.file, "statement": text}) + "\n")
    status = "error"
    try:
        if not os.environ.get("LQ_PASSWORD"):
            sys.exit("lq: LQ_PASSWORD is not set")
        outbox = ROOT / ".lq_outbox"
        outbox.mkdir(exist_ok=True)
        (outbox / f"{key}.json").write_text(json.dumps({"server": SERVERS[a.server], "statement": text}))
        print(f"lq: sent to {a.server} ({SERVERS[a.server]['uri']}), request {key} accepted")
        status = "ok"
    finally:
        with open(ROOT / ".lq_history", "a", encoding="utf-8") as log:
            log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")


if __name__ == "__main__":
    main()
