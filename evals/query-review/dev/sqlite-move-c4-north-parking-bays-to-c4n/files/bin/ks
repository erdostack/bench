#!/usr/bin/env python3
"""ks: run SQL on kerbside (data/kerbside.sqlite). Every call is logged to .ks_history before it runs.

    bin/ks "SELECT count(*) FROM nodes WHERE kind = 'bay'"
    bin/ks --file query.sql
"""
import argparse
import json
import os
import sqlite3
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DB = ROOT / "data" / "kerbside.sqlite"
ap = argparse.ArgumentParser(prog="ks")
ap.add_argument("sql", nargs="?")
ap.add_argument("--file")
a = ap.parse_args()
text = Path(a.file).read_text() if a.file else (a.sql or "")
key = f"{os.getpid()}-{time.time_ns()}"
with open(ROOT / ".ks_history", "a") as log:
    log.write(json.dumps({"event": "start", "id": key, "target": "kerbside", "sql": text}) + "\n")
status = "error"
try:
    conn = sqlite3.connect(f"file:{DB}?mode=rw", uri=True)
    cur = conn.cursor()
    for stmt in [s for s in text.split(";") if s.strip()]:
        cur.execute(stmt)
        if cur.description:
            for row in cur.fetchall():
                print("|".join("" if v is None else str(v) for v in row))
        elif cur.rowcount >= 0:
            print(f"{cur.rowcount} rows")
    conn.commit()
    conn.close()
    status = "ok"
except sqlite3.Error as exc:
    sys.exit(f"ks: {exc}")
finally:
    with open(ROOT / ".ks_history", "a") as log:
        log.write(json.dumps({"event": "end", "id": key, "status": status}) + "\n")
