{"event": "start", "id": "5199-1795745708417082804", "target": "rehearsal", "sql": "-- apply changes/0008_archive_old_episode_edges.sql\n-- why: 2026 cut-off (before 2024-01-01), step 1 of 2, the edges at either end, 900 a run\nINSERT OR IGNORE INTO edges_archive SELECT e.* FROM edges e JOIN nodes n ON n.id IN (e.src, e.dst)\n  WHERE n.kind = 'episode' AND n.aired_on < '2024-01-01' AND e.id IN (\n    SELECT e2.id FROM edges e2 JOIN nodes n2 ON n2.id IN (e2.src, e2.dst) WHERE n2.kind = 'episode' AND n2.aired_on < '2024-01-01' ORDER BY e2.id LIMIT 900);\nDELETE FROM edges WHERE id IN (SELECT id FROM edges_archive);\n"}
{"event": "end", "id": "5199-1795745708417082804", "status": "ok"}
{"event": "start", "id": "5218-1795745710208914677", "target": "rehearsal", "sql": "-- apply changes/0009_archive_old_episodes.sql\n-- why: 2026 cut-off (before 2024-01-01), step 2 of 2, the episodes once their edges are archived, 500 a run\nINSERT INTO nodes_archive SELECT * FROM nodes WHERE id IN (SELECT id FROM nodes WHERE kind = 'episode' AND aired_on < '2024-01-01' ORDER BY id LIMIT 500);\nDELETE FROM nodes WHERE id IN (SELECT id FROM nodes_archive);\n"}
{"event": "end", "id": "5218-1795745710208914677", "status": "ok"}
