{"event": "start", "id": "40011-0", "target": "gis", "file": null, "statement": "EXPLAIN MATCH (w:WorkOrder {type: 'flushing', status: 'closed'})\nWHERE w.closedAt.year <= 2024 AND w:Active\nCALL {\n  WITH w\n  SET w:Archived\n} IN TRANSACTIONS OF 2000 ROWS"}
{"event": "end", "id": "40011-0", "status": "ok"}
{"event": "start", "id": "40111-1", "target": "scratch", "file": null, "statement": "// ticket: OPS-3402\n// what: archive flushing orders closed in 2024 or earlier\n// check: MATCH (w:WorkOrder:Active {type: 'flushing', status: 'closed'}) WHERE w.closedAt.year <= 2024 RETURN count(w);\nMATCH (w:WorkOrder {type: 'flushing', status: 'closed'})\nWHERE w.closedAt.year <= 2024 AND w:Active\nCALL {\n  WITH w\n  SET w:Archived\n} IN TRANSACTIONS OF 2000 ROWS;\n\nMATCH (w:WorkOrder:Archived:Active)\nCALL {\n  WITH w\n  REMOVE w:Active\n} IN TRANSACTIONS OF 2000 ROWS;\n"}
{"event": "end", "id": "40111-1", "status": "ok"}
